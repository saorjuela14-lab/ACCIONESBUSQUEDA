# Application
APP_NAME=NexBuy Investment Committee
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
# Local / Hobby sin Postgres (EFÍMERO en FastAPI Cloud — se borra en redeploy):
DATABASE_URL=sqlite+aiosqlite:///./data/nexbuy.db
# Persistente (OBLIGATORIO para trade journal + track record creíble):
# Neon free https://console.neon.tech — pega la connection string;
# se normaliza a postgresql+asyncpg automáticamente.
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# PASO 01 — filtro tendencia semanal+mensual en ideas diarias
# HTF_TREND_GATE_ENABLED=true
# HTF_TREND_MIN_CONFIDENCE=0.5
# HTF_TREND_MAX_SCREEN=12

# Cache en memoria (no requiere Redis)
REDIS_ENABLED=false
CACHE_TTL_SECONDS=300

# Market Data Providers (fallback chain: Polygon → Alpha Vantage → YFinance)
YFINANCE_ENABLED=true
# Finviz.com — quotes diferidos + news + discovery (sin API key)
FINVIZ_ENABLED=true
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_API_BASE_URL=https://api.massive.com
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
POLYGON_DAILY_LIMIT=1000
POLYGON_PER_MINUTE_LIMIT=5
ALPHA_VANTAGE_DAILY_LIMIT=25
TRADINGVIEW_ENABLED=false
TRADINGVIEW_API_KEY=
# FRED (Federal Reserve Economic Data) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
NEWS_API_KEY=

# LLM — narrativas CEO + cerebro conversacional de Viernes (chat de voz)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Asistente de voz (persona)
VOICE_ASSISTANT_NAME=Viernes
VOICE_BOSS_TITLE=jefe
VOICE_CHAT_ENABLED=true

# Cursor Cloud Agents — Viernes lanza un agente real en el repo (Dashboard → API Keys)
# CURSOR_API_KEY=crsr_...
CURSOR_AGENT_ENABLED=true
CURSOR_AGENT_REPO_URL=https://github.com/saorjuela14-lab/ACCIONESBUSQUEDA
CURSOR_AGENT_STARTING_REF=main
CURSOR_AGENT_AUTO_CREATE_PR=true
# CURSOR_AGENT_MODEL=composer-2

# Opcional: si no hay Cursor, Viernes puede abrir issues en GitHub
# GITHUB_TOKEN=
# GITHUB_REPO=saorjuela14-lab/ACCIONESBUSQUEDA

# ElevenLabs TTS — voz natural tipo secretaria / Friday
# Crea la key en https://elevenlabs.io → Profile → API Keys (debe empezar por sk_)
ELEVENLABS_API_KEY=
# Bella (professional / bright / warm) — más natural con multilingual_v2
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.32
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.55

# Acceso multi-dispositivo (celular + PC) — token de MESA Monarch (interno)
DASHBOARD_ACCESS_TOKEN=elige_un_token_secreto_largo
# Forzar login aunque no haya token de mesa
FORCE_AUTH=false
# Mostrar /docs en production (por defecto oculto)
EXPOSE_API_DOCS=false
# Bootstrap opcional de la primera empresa (si la DB no tiene usuarios)
COMPANY_BOOTSTRAP_EMAIL=
COMPANY_BOOTSTRAP_PASSWORD=
COMPANY_BOOTSTRAP_NAME=Empresa demo
# URL pública tras desplegar (opcional): https://nexbuy-ceo.fastapicloud.dev
PUBLIC_BASE_URL=

# Scheduler (US Eastern market hours)
MARKET_TIMEZONE=America/New_York
REPORT_TIMES=08:30,11:30,15:00,17:30

# Investment Director
AGENT_WEIGHTS_AUTO_CALIBRATE=true
MAX_CONCENTRATION_PCT=25.0

# Automation (Phase 3)
SCHEDULER_ENABLED=true
WATCHLIST_SCAN_INTERVAL_MINUTES=30
MEMORY_EVALUATION_DAYS=90
ALERT_COOLDOWN_HOURS=24

# Push notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
PUSH_DAILY_TRADES=true

# WhatsApp — status diario apertura/cierre (elige UN proveedor)
# 1) CallMeBot (personal, rápido):
#    - Guarda en contactos: +34 644 78 33 97 (número actual; los viejos mueren a menudo)
#    - Por WhatsApp envía: I allow callmebot to send me messages
#    - Te responde con WHATSAPP_API_KEY
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=auto
WHATSAPP_PHONE=
WHATSAPP_API_KEY=
# 2) Meta Cloud API (Business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=v21.0
# Opcional: plantilla aprobada para mensajes proactivos fuera de ventana 24h
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es
# 3) Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_BRIEFING_ENABLED=true
# Exactamente 3 mensajes/día (ET): apertura, almuerzo, cierre — no cada 5 min
WHATSAPP_BRIEFING_TIMES=09:35,12:30,16:05

# Alpaca Trading + Market Data — compatible con https://github.com/alpacahq/cli
# Genera keys de la cuenta REAL (brokerage). NO las subas al repo.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=false
# Alternativa CLI: ALPACA_LIVE_TRADE=true fuerza LIVE (gana sobre ALPACA_PAPER)
ALPACA_LIVE_TRADE=true
# Trading base URL (vacío → https://api.alpaca.markets si LIVE)
ALPACA_BASE_URL=
# Market Data API
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# iex = gratis (IEX); sip = todas las bolsas (requiere suscripción)
ALPACA_DATA_FEED=iex
# Depósito cliente → datos bancarios de la cuenta compartida (NO enlace de login Alpaca).
# Obtén routing/cuenta en Alpaca (mesa) → Funds → Incoming wire / ACH deposit details.
# NO uses «Deposit Funds → Select» (eso conecta TU banco vía Plaid; solo la mesa).
ALPACA_FUNDING_URL=
ALPACA_FUNDING_ACCOUNT_NAME=Monarch Capital
ALPACA_FUNDING_BENEFICIARY=Monarch Capital
ALPACA_FUNDING_BANK_NAME=
ALPACA_FUNDING_ROUTING_NUMBER=
ALPACA_FUNDING_ACCOUNT_NUMBER=
ALPACA_FUNDING_ACCOUNT_TYPE=Checking
ALPACA_FUNDING_SWIFT=
ALPACA_FUNDING_INSTRUCTIONS=
ALPACA_FUNDING_WIRE_DETAILS=

# Risk Desk + macro (gestión de riesgo en recomendaciones y órdenes)
RISK_MAX_POSITION_PCT=35
RISK_MAX_SECTOR_PCT=40
RISK_MAX_GROSS_EXPOSURE_PCT=90
RISK_CASH_RESERVE_PCT=10
RISK_MAX_DAILY_LOSS_PCT=5
RISK_MAX_OPEN_POSITIONS=8
RISK_REQUIRE_STOP_LOSS=true
RISK_MIN_REWARD_RISK=1.2
RISK_OFF_SIZE_MULT=0.35
RISK_CRISIS_BLOCK_BUYS=true
# Firma autónoma (compras/cierres sin click). Kill switch + comité + risk desk siguen activos.
FIRM_AUTONOMY=true
AUTO_EXECUTE_TRADES=true
AUTO_EXECUTE_LIVE=true
AUTO_EXECUTE_MAX_NOTIONAL=25
AUTO_EXECUTE_REQUIRE_MARKET_OPEN=true
AUTO_EXECUTE_PAPER_FIRST=false
# Autopilot programado cada N minutos en horario de mercado (0 = off; con FIRM_AUTONOMY usa 30)
AUTOPILOT_INTERVAL_MINUTES=10

# Lifecycle (trailing / time-stop / thesis → exit)
LIFECYCLE_ENABLED=true
LIFECYCLE_SCAN_INTERVAL_MINUTES=15
LIFECYCLE_TRAILING_PCT=0.08
LIFECYCLE_TIME_STOP_DAYS=10
LIFECYCLE_DEFAULT_STOP_PCT=0.08
LIFECYCLE_DEFAULT_TARGET_PCT=0.12
LIFECYCLE_AUTO_EXIT=true

# Reconciliación Alpaca ↔ DB
RECONCILE_INTERVAL_MINUTES=20
RECONCILE_AUTO_SYNC=true

# VaR / beta / sectores duros
RISK_MAX_VAR_PCT=8
RISK_MAX_PORTFOLIO_BETA=1.8
RISK_ENFORCE_SECTOR_CAP=true
RISK_ENFORCE_VAR_BETA=true

# Retry
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=1.5
