  "pipeline": {
    "name": "How a stock is chosen and managed",
    "flow": [
      "discovery",
      "capital_price_filter",
      "committee_or_micro_desk",
      "investment_director_plus_strategy_lab",
      "consensus_gate",
      "risk_desk_plus_macro",
      "sizing_2r",
      "alpaca_live_brackets",
      "lifecycle_trail_timestop",
      "reconcile_audit",
      "smart_eod",
      "daily_learn_lessons",
      "agent_justification_learn"
    ],
    "discovery": {
      "orchestrator": "CompanyDiscoveryService",
      "sources": [
        {
          "id": "stocktwits",
          "module": "providers/discovery/stocktwits_trending.py",
          "weight": 1.2
        },
        {
          "id": "news",
          "module": "providers/discovery/news_scanner.py",
          "weight": 1.1
        },
        {
          "id": "x_twitter",
          "module": "providers/discovery/x_search_provider.py",
          "weight": 1.0,
          "method": "DuckDuckGo site:x.com"
        },
        {
          "id": "reddit",
          "module": "providers/discovery/reddit_discovery.py",
          "weight": 0.9,
          "method": "DuckDuckGo site:reddit.com"
        },
        {
          "id": "micro_seeds",
          "via": "MicroPortfolioManagerService"
        },
        {
          "id": "watchlist",
          "interval_minutes": 30
        }
      ],
      "capital_fit": {
        "module": "services/capital_fit.py",
        "idea": "Price and theme universe scale with equity (micro/small/medium/standard)",
        "ultra_micro_behavior": "Penny themes + hard max share price so ~$22 books do not chase $200 names"
      }
    },
    "committee": {
      "orchestrator": "AnalysisService._run_committee",
      "director": "agents/investment_director.py",
      "strategy_lab": "services/strategy_lab.py",
      "voting_agents_strict_10": [
        {
          "id": "fundamental_agent",
          "looks_at": "Business / fundamentals"
        },
        {
          "id": "technical_agent",
          "looks_at": "Multi-TF price, gaps, volume, structure, playbook"
        },
        {
          "id": "valuation_agent",
          "looks_at": "Valuation"
        },
        {
          "id": "macro_agent",
          "looks_at": "Macro regime (FRED when keyed)"
        },
        {
          "id": "news_agent",
          "looks_at": "News / catalysts"
        },
        {
          "id": "sentiment_agent",
          "looks_at": "Social sentiment"
        },
        {
          "id": "country_risk_agent",
          "looks_at": "Country risk"
        },
        {
          "id": "company_risk_agent",
          "looks_at": "Company risk"
        },
        {
          "id": "corporate_actions_agent",
          "looks_at": "Splits, dividends, events"
        },
        {
          "id": "market_dependency_agent",
          "looks_at": "Market/sector dependencies"
        }
      ],
      "book_agents_non_voting": [
        "portfolio_agent",
        "watchlist_agent",
        "alert_agent",
        "investment_memory"
      ],
      "strategy_horizons": {
        "short": [
          "momentum",
          "swing",
          "breakout"
        ],
        "long": [
          "value",
          "growth"
        ],
        "long_optional": [
          "dividend"
        ]
      },
      "consensus": {
        "module": "services/committee_consensus.py",
        "strict": {
          "tag": "committee_unanimous_dual",
          "rule": "All voting agents BUY/STRONG_BUY + short strategies BUY + long strategies BUY + director thesis BUY"
        },
        "micro": {
          "tag": "committee_majority_dual_soft",
          "voting_agents": 8,
          "rule": "≥4 BUY, ≤2 SELL, no STRONG_SELL, soft dual-horizon"
        },
        "ultra_micro_desk": {
          "when_equity_usd_le": 30,
          "tag": "micro_technical_desk",
          "why": "Full 10-agent committee often times out on sleeping edge hosts",
          "still_required": "Some actionable source tag before auto-execute"
        },
        "score_thresholds": {
          "buy_ge": 15,
          "sell_le": -15
        }
      }
    },
    "risk_desk": {
      "module": "services/risk_policy_service.py",
      "defaults": {
        "max_position_pct": 35,
        "max_sector_pct": 40,
        "max_gross_exposure_pct": 90,
        "cash_reserve_pct": 10,
        "max_daily_loss_pct": 5,
        "max_open_positions": 8,
        "min_reward_risk": 1.2,
        "risk_off_size_mult": 0.35,
        "crisis_block_buys": true,
        "max_var_pct": 8,
        "max_portfolio_beta": 1.8,
        "auto_execute_max_notional_usd": 25,
        "auto_execute_max_risk_pct": 2.5,
        "auto_execute_micro_max_risk_pct": 4.0,
        "auto_execute_max_position_pct": 0.3,
        "post_stop_cooldown_minutes": 90
      },
      "macro": "MacroRegimeService + FRED/yfinance providers"
    },
    "sizing_and_lifecycle": {
      "stop_pct": 0.08,
      "take_profit_pct": 0.16,
      "rr": "2R",
      "trail_arm_profit_pct": 0.05,
      "trail_pct_standard": 0.08,
      "trail_pct_micro": 0.1,
      "time_stop_days_standard": 10,
      "time_stop_days_micro": 7,
      "stagnation_days": 2,
      "stagnation_min_pnl_pct": 1.5,
      "brackets": "Alpaca order_class=bracket, GTC when overnight carry allowed",
      "modules": [
        "services/position_lifecycle_service.py",
        "services/holdings_strategy_review_service.py",
        "services/intraday_flat_service.py"
      ]
    },
    "execution": {
      "broker": "AlpacaOrderService + providers/broker/alpaca_provider.py",
      "auto_execute": "services/auto_execute_service.py",
      "gates_before_buy": [
        "kill_switch_off",
        "committee_or_micro_source_tag",
        "risk_desk_ok",
        "market_open",
        "not_in_eod_buy_block_window",
        "post_stop_cooldown_clear",
        "cash_and_concentration_ok",
        "brackets_required"
      ],
      "max_lines_per_autopilot_cycle": 2
    },
    "autopilot_loop_order": [
      "Abort if kill switch",
      "ReconcileService.reconcile",
      "Sweep USDT/USDC → USD",
      "IntradayFlatService (smart EOD if in window)",
      "RiskPolicyService.status",
      "HoldingsStrategyReviewService.review",
      "PositionLifecycleService.scan",
      "DailyTradeRecommendationService.generate (exclude 24h lesson tickers)",
      "AutoExecuteService.run_from_picks",
      "WhatsApp briefing catch-up"
    ],
    "smart_eod": {
      "window_et": "15:40",
      "winners_only": true,
      "min_pnl_pct_to_close": 0,
      "carry_max_loss_pct": 8,
      "behavior": "Bank greens/flat; carry moderate reds overnight; cut ≤−8% or sell thesis"
    },
    "daily_learn_lessons": {
      "evaluate_hours": 5,
      "hit_pct": 1.5,
      "jobs_et": ["08:15 pre_open", "16:10 close", "17:30 daily_report"],
      "false_long": "avoid ticker 24h on next open picks/autopilot",
      "weights": "agent_weights recalibrated each eval",
      "persist": "desk_lessons table — requires Neon DATABASE_URL",
      "trade_close_review": "On LIVE close: TP = win, stop/tesis = loss, EOD/absent with |PnL|<1.5% = stagnation (review + avoid 48h). EOD with real progress stays gestión (not 2R).",
      "agent_justification_learn": "Persist per-agent briefs. On win/loss/stagnation, critique why. Wrong → desk_lessons agent_error ~7d; next committee clips repeating justification.",
      "stagnation_rotate": "Lifecycle exits if held ≥2d and PnL < 1.5% (even if slightly green). Stops sitting a week in one micro name."
    }
  },
